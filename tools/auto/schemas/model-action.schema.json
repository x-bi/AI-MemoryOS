{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory OS model action",
  "type": "object",
  "required": ["action", "tier", "target"],
  "properties": {
    "action": { "type": "string" },
    "tier": { "type": "string", "enum": ["A", "B", "C"] },
    "target": { "type": "string" },
    "summary": { "type": "string" },
    "proposal_title": { "type": "string" },
    "approval_sheet_title": { "type": "string" },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "old_text", "new_text"],
        "properties": {
          "path": { "type": "string" },
          "old_text": { "type": "string" },
          "new_text": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "patch": { "type": "string" }
  },
  "additionalProperties": true
}
